# SELVIA environment configuration
# Copy to .env and fill in values. Never commit .env.

# General
NODE_ENV=development
LOG_LEVEL=info

# Application ports
FRONTEND_PORT=3000
BACKEND_PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/selvia

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM provider
LLM_API_KEY=
